generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
  OWNER
}

enum ProjectTarget {
  WEBSITE
  MOBILE_APP
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  DEPLOYING
  LIVE
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String?
  role         UserRole    @default(VIEWER)
  memberships  Membership[]
  comments     Comment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Workspace {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  projects     Project[]
  memberships  Membership[]
  billingPlan  String       @default("free")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id          String     @id @default(cuid())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  workspaceId String
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  role        UserRole

  @@unique([workspaceId, userId])
}

model Project {
  id            String         @id @default(cuid())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  workspaceId    String
  name           String
  prompt         String
  target         ProjectTarget
  stack          String
  audience       String
  status         ProjectStatus  @default(DRAFT)
  components     Component[]
  deployments    Deployment[]
  comments       Comment[]
  buildArtifacts BuildArtifact[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Component {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  type         String
  label        String
  props        Json
  parentId     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deployment {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  environment  String
  status       String
  previewUrl   String?
  logsUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  targetType  String
  targetId    String
  body        String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuildArtifact {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  type        String
  location    String
  metadata    Json?
  createdAt   DateTime @default(now())
}
