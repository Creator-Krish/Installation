{
  "name": "buildforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "db:push": "pnpm --filter @buildforge/api prisma db push",
    "db:generate": "pnpm --filter @buildforge/api prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  }
}
{
  "dependencies": {
    "zod": "^3.24.1"
  }
}
